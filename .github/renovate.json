{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "addLabels": ["renovate", "bot", "dependencies"],
  "commitBodyTable": true,
  "extends": ["config:recommended", ":enableVulnerabilityAlerts", "helpers:pinGitHubActionDigests"],
  "gitAuthor": "Renovate <renovate@rolfmoleman.com>",
  "packageRules": [
    {
      "matchDatasources": ["azure-pipelines-tasks"],
      "enabled": false,
      "extractVersion": "^(?<version>\\d+)"
    },
    {
      "description": "Automatically merge patch versions",
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Automatically merge minor versions",
      "matchUpdateTypes": ["minor"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Require review for major versions",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "automergeType": "pr"
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "Group Terraform provider updates",
      "matchManagers": ["terraform"],
      "groupName": "Terraform providers",
      "automerge": false
    },
    {
      "description": "Add package names to this array to exclude them from Renovate updates",
      "excludePackageNames": []
    }
  ],
  "prConcurrentLimit": 3,
  "prHourlyLimit": 1,
  "schedule": ["before 7am on monday"],
  "dependencyDashboard": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "prConcurrentLimit": 1,
    "labels": ["security", "renovate"],
    "automerge": false
  }
}
